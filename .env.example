# ExamPool 환경 변수 (모두 선택 사항 — 기본값 있음)
# .env.example → 복사해서 .env 로 쓰세요.

# HTTP 서버 포트 (기본 8632)
# EXAMPOOL_PORT=8632

# 5E 메인 프로젝트 절대경로 (기본: ../51_5E/5E_main)
# EXAMPOOL_5E_ROOT=C:\Users\user\Desktop\project\51_5E\5E_main

# 5E dev 서버 포트 (기본 8190)
# EXAMPOOL_FIVEE_PORT=8190

# 5E MCP 브리지 시작 포트 (기본 8579)
# EXAMPOOL_FIVEE_BRIDGE_PORT=8579

# hwppalette 프로젝트 루트 (기본: ../hwppalette)
# EXAMPOOL_HWPPAL_ROOT=C:\Users\user\Desktop\project\hwppalette

# 문항 사진 저장 폴더
# EXAMPOOL_PHOTO_ROOT=

# Codex CLI 명령어 (기본: codex)
# EXAMPOOL_CODEX_COMMAND=codex

# Codex 기본 모델
# EXAMPOOL_CODEX_MODEL=

# Codex reasoning effort (low/medium/high)
# EXAMPOOL_CODEX_REASONING=

# Codex 요청 타임아웃(초) (기본 300)
# EXAMPOOL_CODEX_TIMEOUT=300

# 로그 레벨 (DEBUG/INFO/WARNING/ERROR, 기본 INFO)
# EXAMPOOL_LOG_LEVEL=INFO
