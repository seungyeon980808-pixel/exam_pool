{
  "schema_version": "ocr-hybrid-policy-v1",
  "policy_id": "pdf-math-ocr-hybrid-v1",
  "status": "VERIFIED",
  "authoritative_source": "reviewed_pdf_manifest",
  "source_manifest_schema": "math-source-manifest-v1",
  "content_scope_manifest_schema": "math-content-scope-manifest-v1",
  "content_scope_policy": "problem_solution_regions_only",
  "primary_ocr": {
    "engine": "paddle_local_primary",
    "mode": "local",
    "required": true,
    "role": "coordinate_ocr_candidate",
    "scope_mode": "reviewed_regions_only"
  },
  "exam_pool_converter": {
    "engine": "exam_pool_v0.1.1",
    "release": "hwp-converter-v0.1.1",
    "commit": "be1893f",
    "role": "secondary_ocr_and_native_typesetter",
    "mode": "local",
    "required_when_used": {
      "strict_wrapper": true,
      "fallback_policy": "fail_closed",
      "full_page_fallback": "forbidden",
      "formula_image_fallback": "forbidden",
      "formula_plain_text_fallback": "forbidden",
      "equation_font": "HancomEQN",
      "equation_base_unit": 1100
    }
  },
  "anydoc": {
    "engine": "firecrawl_anydoc",
    "role": "optional_secondary_structure_candidate",
    "local_mode_allowed": true,
    "hosted_mode_default": "disabled",
    "hosted_requires_transfer_approval": true,
    "hosted_whole_document_sent": true,
    "page_selection_supported": false,
    "direct_hwp_writer_input": false,
    "direct_math_authority": false
  },
  "merge_policy": "manual_on_disagreement",
  "review": {
    "page_render_dpi": [600, 900],
    "formula_crop_dpi": 900,
    "unresolved_disagreement_is_fail": true,
    "ocr_confidence_is_triage_only": true
  },
  "required_provenance": [
    "source_pdf_sha256",
    "source_manifest_sha256",
    "content_scope_manifest_schema",
    "content_scope_manifest_sha256",
    "ocr_region_ids",
    "engine_versions",
    "engine_config_hashes",
    "candidate_output_sha256",
    "disagreement_count",
    "disagreement_records",
    "transfer_approval"
  ],
  "forbidden_shortcuts": [
    "ocr_to_hwp_without_reviewed_manifest",
    "ocr_entire_document_without_reviewed_scope",
    "ocr_excluded_frontmatter_or_concept_regions",
    "one_endnote_per_pdf_page",
    "page_round_robin_solution_mapping",
    "printed_number_only_solution_mapping",
    "majority_vote_for_math_tokens",
    "page_capture_fallback",
    "formula_plain_text_fallback",
    "formula_image_fallback",
    "unlogged_hosted_upload"
  ]
}
